#!/usr/bin/env bash
# /usr/local/sbin/crom-publish-helper
# Executado via sudo sem senha pelo crom-ws

set -euo pipefail

ACTION="${1:-}"

if [[ "$ACTION" == "list" ]]; then
    # Return list of active published ports
    # format: port:user:project:url
    for file in /etc/nginx/sites-enabled/crom-*; do
        if [[ -f "$file" ]]; then
            fname=$(basename "$file")
            # fname format: crom-USER-PROJECT
            # We must be careful because project can have hyphens.
            # Better to reconstruct from file content if needed, 
            # but let's extract user from filename and rest is project.
            # Format is exactly crom-${USER_NAME}-${PROJECT}
            user=$(echo "$fname" | cut -d'-' -f2)
            proj=$(echo "$fname" | cut -d'-' -f3-)
            port=$(grep "proxy_pass" "$file" | grep -oE "127\.0\.0\.1:[0-9]+" | cut -d: -f2 || echo "N/A")
            url=$(grep "server_name" "$file" | awk '{print $2}' | tr -d ';' || echo "N/A")
            echo "${port}:${user}:${proj}:${url}"
        fi
    done
    exit 0
fi

USER_NAME="${2:-}"
PROJECT="${3:-}"

if [[ -z "$USER_NAME" || -z "$PROJECT" ]]; then
    echo "Uso: $0 add <user> <project> <port>"
    echo "       $0 rm <user> <project>"
    exit 1
fi

# Validação do nome e projeto para evitar injection
if [[ ! "$USER_NAME" =~ ^[a-z0-9_-]+$ ]] || [[ ! "$PROJECT" =~ ^[a-z0-9_-]+$ ]]; then
    echo "ERRO: Usuário ou projeto inválido."
    exit 1
fi

CONF_FILE="/etc/nginx/sites-available/crom-${USER_NAME}-${PROJECT}"
LINK_FILE="/etc/nginx/sites-enabled/crom-${USER_NAME}-${PROJECT}"

# Garantir que /etc/nginx/sites-available existe
mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

HOST_DOMAIN=$(hostname -f 2>/dev/null || echo "crom.me")
# Se hostname -f retornar apenas o hostname curto, vamos usar o hostname se tiver ponto, senão crom.me
if [[ "$HOST_DOMAIN" != *.* ]]; then
    if [[ "$(hostname)" == "vps1" ]]; then
        HOST_DOMAIN="vps1.crom.me"
    elif [[ "$(hostname)" == "vps2" ]]; then
        HOST_DOMAIN="vps2.crom.me"
    else
        HOST_DOMAIN="crom.me"
    fi
fi

if [[ "$ACTION" == "add" ]]; then
    PORT="${4:-}"
    if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then
        echo "ERRO: Porta inválida."
        exit 1
    fi
    
    CUSTOM_DOMAIN="${5:-}"
    if [[ -n "$CUSTOM_DOMAIN" ]]; then
        URL="$CUSTOM_DOMAIN"
    else
        URL="${PROJECT}-${USER_NAME}.${HOST_DOMAIN}"
    fi
    
    # Gerar Nginx conf
    cat > "$CONF_FILE" <<EOF
server {
    listen 80;
    server_name ${URL};

    location / {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        
        # Websocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
EOF
    ln -sf "$CONF_FILE" "$LINK_FILE"
    
    nginx -t >/dev/null 2>&1 || {
        echo "ERRO: Configuração do Nginx falhou."
        rm -f "$CONF_FILE" "$LINK_FILE"
        exit 1
    }
    
    systemctl reload nginx >/dev/null 2>&1
    
    # Try to issue SSL certificate silently
    SSL_STATUS="(HTTP apenas - SSL falhou ou DNS pendente)"
    if command -v certbot >/dev/null 2>&1; then
        if certbot --nginx -d "${URL}" --non-interactive --register-unsafely-without-email --agree-tos --redirect >/dev/null 2>&1; then
            SSL_STATUS="(HTTPS ativado)"
        fi
    fi
    
    echo "SUCESSO:${URL} ${SSL_STATUS}"
    exit 0

elif [[ "$ACTION" == "rm" ]]; then
    if [[ -f "$CONF_FILE" ]]; then
        # Extrair URL antes de apagar
        URL_TO_DEL=$(grep "server_name" "$CONF_FILE" | awk '{print $2}' | tr -d ';' || echo "")
        rm -f "$CONF_FILE" "$LINK_FILE"
        systemctl reload nginx >/dev/null 2>&1
        
        # Tentar limpar o certificado SSL
        if [[ -n "$URL_TO_DEL" ]] && command -v certbot >/dev/null 2>&1; then
            certbot delete --cert-name "$URL_TO_DEL" --non-interactive >/dev/null 2>&1 || true
        fi
        
        echo "SUCESSO"
    else
        echo "ERRO: Projeto não estava publicado."
    fi
    exit 0
else
    echo "Ação inválida."
    exit 1
fi
