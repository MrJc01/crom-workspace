#!/usr/bin/env bash
# /usr/local/sbin/crom-publish-helper
# Executado via sudo sem senha pelo crom-ws

set -euo pipefail

ACTION="${1:-}"

if [[ "$ACTION" == "list" ]]; then
    # Return list of active published ports
    # format: port:user:project:url
    for file in /etc/dokploy/traefik/dynamic/crom-ws-*.yml; do
        if [[ -f "$file" ]]; then
            fname=$(basename "$file" .yml)
            user=$(echo "$fname" | cut -d'-' -f3)
            proj=$(echo "$fname" | cut -d'-' -f4-)
            port=$(grep "url:" "$file" | grep -oE "172\.17\.0\.1:[0-9]+" | cut -d: -f2 || echo "N/A")
            url=$(grep "rule: \"Host" "$file" | awk -F'Host\\(\`' '{print $2}' | awk -F'\`\\)' '{print $1}' || echo "N/A")
            echo "${port}:${user}:${proj}:${url}"
        fi
    done
    exit 0
fi

USER_NAME="${2:-}"
PROJECT="${3:-}"

if [[ -z "$USER_NAME" || -z "$PROJECT" ]]; then
    echo "Uso: $0 add <user> <project> <port>"
    echo "       $0 rm <user> <project>"
    exit 1
fi

# Validação do nome e projeto para evitar injection
if [[ ! "$USER_NAME" =~ ^[a-z0-9_-]+$ ]] || [[ ! "$PROJECT" =~ ^[a-z0-9_-]+$ ]]; then
    echo "ERRO: Usuário ou projeto inválido."
    exit 1
fi

CONF_FILE="/etc/dokploy/traefik/dynamic/crom-ws-${USER_NAME}-${PROJECT}.yml"

# Garantir que pasta existe
mkdir -p /etc/dokploy/traefik/dynamic

HOST_DOMAIN=$(hostname -f 2>/dev/null || echo "crom.me")
if [[ "$HOST_DOMAIN" != *.* ]]; then
    HOST_DOMAIN="crom.me"
fi

if [[ "$ACTION" == "add" ]]; then
    PORT="${4:-}"
    if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then
        echo "ERRO: Porta inválida."
        exit 1
    fi
    
    CUSTOM_DOMAIN="${5:-}"
    if [[ -n "$CUSTOM_DOMAIN" ]]; then
        URL="$CUSTOM_DOMAIN"
    else
        URL="${PROJECT}-${USER_NAME}.${HOST_DOMAIN}"
    fi
    
    # Gerar Traefik conf
    cat > "$CONF_FILE" <<EOF
http:
  routers:
    router-ws-${USER_NAME}-${PROJECT}:
      rule: "Host(\`${URL}\`)"
      service: service-ws-${USER_NAME}-${PROJECT}
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
  services:
    service-ws-${USER_NAME}-${PROJECT}:
      loadBalancer:
        servers:
          - url: "http://172.17.0.1:${PORT}"
        passHostHeader: true
EOF
    
    echo "SUCESSO:${URL} (HTTPS gerenciado nativamente pelo Traefik)"
    exit 0

elif [[ "$ACTION" == "rm" ]]; then
    if [[ -f "$CONF_FILE" ]]; then
        rm -f "$CONF_FILE"
        echo "SUCESSO"
    else
        echo "ERRO: Projeto não estava publicado."
    fi
    exit 0
else
    echo "Ação inválida."
    exit 1
fi
