#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# CROM Workspace v1.1.0 — Ferramenta de projetos para membros
# Cada comando é logado para auditoria do admin (root)
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

VERSION="1.1.0"
USER_NAME="$(whoami)"
PROJECTS_DIR="$HOME/projetos"
CROM_REG="$HOME/.crom"
CROM_HIST="$CROM_REG/history.log"
CENTRAL_LOG="/var/log/crom-membros/${USER_NAME}.log"
CENTRAL_REG="/var/log/crom-membros/registry/${USER_NAME}"
QUADLET_DIR="${HOME}/.config/containers/systemd"

# ─── Cores ────────────────────────────────────────────────────
C_R='\033[0;31m'; C_G='\033[0;32m'; C_Y='\033[1;33m'
C_C='\033[0;36m'; C_P='\033[0;35m'; C_B='\033[1m'
C_D='\033[2m'; NC='\033[0m'

# ─── Funções base ─────────────────────────────────────────────
log_action() {
    local ts=$(date '+%Y-%m-%d %H:%M:%S')
    local e="[${ts}] USER=${USER_NAME} ACTION=$1 DETAILS=\"${2:-}\""
    echo "$e" >> "$CROM_HIST" 2>/dev/null || true
    echo "$e" >> "$CENTRAL_LOG" 2>/dev/null || true
}

ensure_dirs() {
    mkdir -p "$PROJECTS_DIR" "$CROM_REG" "$CENTRAL_REG" 2>/dev/null || true
    if [[ ! -f "$CROM_REG/config" ]]; then
        echo "USER=${USER_NAME}" > "$CROM_REG/config"
        echo "CREATED=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$CROM_REG/config"
        log_action "INIT" "Workspace inicializado"
    fi
}

info()    { echo -e "  ${C_C}ℹ${NC}  $*"; }
success() { echo -e "  ${C_G}✓${NC}  $*"; }
warn()    { echo -e "  ${C_Y}⚠${NC}  $*"; }
err()     { echo -e "  ${C_R}✗${NC}  $*"; }

# ─── Carregar módulos ─────────────────────────────────────────
# Os módulos ficam em /usr/local/lib/crom-ws/modules/ (no servidor)
# ou na pasta cli/modules/ (desenvolvimento local)
MODULES_DIR="/usr/local/lib/crom-ws/modules"
if [[ ! -d "$MODULES_DIR" ]]; then
    # Fallback para desenvolvimento local
    MODULES_DIR="$(dirname "$(readlink -f "$0")")/modules"
fi

if [[ -d "$MODULES_DIR" ]]; then
    source "${MODULES_DIR}/projects.sh"
    source "${MODULES_DIR}/publish.sh"
    source "${MODULES_DIR}/podman.sh"
fi

# ─── Comandos do sistema ──────────────────────────────────────
cmd_history() {
    echo -e "\n  ${C_P}${C_B}📜 HISTÓRICO${NC}\n"
    [[ -f "$CROM_HIST" ]] && tail -n "${1:-20}" "$CROM_HIST" | sed 's/^/  /' || warn "Vazio"
    echo
}

cmd_status() {
    echo -e "\n  ${C_P}${C_B}📊 STATUS${NC}\n"
    local t=$(find "$PROJECTS_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
    local d=$(du -sh "$HOME" 2>/dev/null | awk '{print $1}')
    echo -e "  ╔════════════════════════════════╗"
    printf "  ║  User:     %-19s ║\n" "$USER_NAME"
    printf "  ║  Projetos: %-19s ║\n" "$t"
    printf "  ║  Disco:    %-19s ║\n" "$d"
    printf "  ║  Versão:   %-19s ║\n" "$VERSION"
    echo -e "  ╚════════════════════════════════╝\n"
    log_action "VIEW_STATUS" "projects=$t"
}

cmd_help() {
    echo -e "\n  ${C_P}${C_B}CROM Workspace v${VERSION}${NC}\n"
    echo -e "  ${C_B}Projetos:${NC}"
    echo -e "  ${C_C}crom-ws init${NC} [nome]         Criar projeto"
    echo -e "  ${C_C}crom-ws list${NC}                Listar projetos"
    echo -e "  ${C_C}crom-ws info${NC} [projeto]      Detalhes do projeto"
    echo -e "  ${C_C}crom-ws delete${NC} [nome]       Deletar projeto\n"
    echo -e "  ${C_B}Publicação Web:${NC}"
    echo -e "  ${C_C}crom-ws publish${NC} [nome] [p]  Publicar projeto na web"
    echo -e "  ${C_C}crom-ws unpublish${NC} [nome]    Remover publicação"
    echo -e "  ${C_C}crom-ws ports${NC}               Ver portas em uso no servidor\n"
    echo -e "  ${C_B}Containers (Podman):${NC}"
    echo -e "  ${C_C}crom-ws podman${NC} [sub]        Gerenciar containers (run/stop/rm/list/logs)"
    echo -e "  ${C_C}crom-ws podman help${NC}         Ajuda detalhada dos containers\n"
    echo -e "  ${C_B}Sistema:${NC}"
    echo -e "  ${C_C}crom-ws status${NC}              Status geral"
    echo -e "  ${C_C}crom-ws history${NC} [n]         Últimas ações"
    echo -e "  ${C_C}crom-ws help${NC}                Esta ajuda\n"
    echo -e "  ${C_D}Todos os comandos são registrados.${NC}\n"
}

# ─── Roteador ─────────────────────────────────────────────────
ensure_dirs
case "${1:-}" in
    init|new)       shift; cmd_init "$@" ;;
    list|ls)        cmd_list ;;
    info|show)      shift; cmd_info "$@" ;;
    delete|rm)      shift; cmd_delete "$@" ;;
    publish|pub)    shift; cmd_publish "$@" ;;
    unpublish|unpub) shift; cmd_unpublish "$@" ;;
    ports)          cmd_ports ;;
    podman|pod)     shift; cmd_podman "$@" ;;
    status|st)      cmd_status ;;
    history|log)    shift; cmd_history "$@" ;;
    version|-v)     echo "crom-ws v${VERSION}" ;;
    help|-h|"")     cmd_help ;;
    *)              err "Desconhecido: $1 (use 'crom-ws help')" ;;
esac
